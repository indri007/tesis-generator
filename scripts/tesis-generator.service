[Unit]
Description=TesisCheck MIKOM 2026 Streamlit App
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/TesisCheck_MIKOM2026
Environment="PATH=/home/ubuntu/TesisCheck_MIKOM2026/venv/bin"
ExecStart=/home/ubuntu/TesisCheck_MIKOM2026/venv/bin/streamlit run app.py \
    --server.port=8501 \
    --server.address=127.0.0.1 \
    --server.headless=true

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
