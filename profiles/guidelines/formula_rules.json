{
  "category": "formula",
  "symbol_definitions_required": true,
  "model_consistency": {
    "compare_chapters": ["BAB III", "BAB IV"],
    "check_notations": true,
    "check_variable_counts": true
  },
  "recalculation": {
    "enabled": true,
    "delta_threshold": 0.01,
    "supported_operators": ["+", "-", "*", "/", "^", "(", ")"]
  },
  "statistical_checks": {
    "default_alpha": 0.05,
    "p_value_threshold": 0.05,
    "rejection_rule": "p < alpha -> Significant (Reject H0, Accept Ha)"
  }
}
