{
  "category": "format",
  "paper": {
    "size": "A4",
    "width_cm": 21.5,
    "height_cm": 29.0,
    "weight_gsm": 80,
    "color": "putih"
  },
  "margins": {
    "top_cm": 4.0,
    "left_cm": 4.0,
    "bottom_cm": 3.0,
    "right_cm": 3.0,
    "tolerance_cm": 0.2
  },
  "typography": {
    "font_family": "Times New Roman",
    "body_size_pt": 12,
    "title_bab_size_pt": 14,
    "subbab_size_pt": 12,
    "allowed_exceptions": {
      "table_data_min_pt": 10,
      "footnote_pt": 10
    }
  },
  "spacing": {
    "body_line_spacing": 2.0,
    "abstract_line_spacing": 1.0,
    "direct_quote_min_lines": 3,
    "direct_quote_line_spacing": 1.0,
    "direct_quote_indent_chars": 7,
    "table_title_multiline_spacing": 1.0,
    "references_line_spacing": 1.0,
    "subbab_before_space_lines": 4
  },
  "paragraph": {
    "alignment": "JUSTIFY",
    "first_line_indent_pt": 36.0,
    "first_line_indent_chars": 5
  },
  "page_numbering": {
    "preliminary": {
      "type": "roman_lower",
      "position": "bottom_center"
    },
    "body": {
      "type": "arabic",
      "standard_position": "top_right",
      "chapter_first_page_position": "bottom_center",
      "margin_right_cm": 3.0,
      "margin_edge_cm": 1.5
    }
  }
}
